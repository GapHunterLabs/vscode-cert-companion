{
  "name": "cert-companion",
  "displayName": "Cert Companion",
  "description": "Decode X.509 certificates (PEM/CRT/CER/DER) -- subject, issuer, validity, fingerprint -- no data leaves your editor.",
  "version": "0.1.1",
  "publisher": "GapHunterLabs",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "certificate",    "x509",    "pem",    "tls",    "ssl",    "security"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GapHunterLabs/vscode-cert-companion.git"
  },
  "bugs": {
    "url": "https://github.com/GapHunterLabs/vscode-cert-companion/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "certCompanion.decodeActiveFile",
        "title": "Cert Companion: Decode Certificate File"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2"
  }
}
